{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "beixiaoguo-cf",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.wasm"
      ]
    },
    {
      "type": "Text",
      "globs": [
        "**/wasm_exec.js"
      ]
    }
  ]
}
